rules_version = '2';

// 이 앱은 Streamlit 서버(Python)가 Firebase Admin SDK로만 Firestore에 접근합니다.
// Admin SDK는 보안 규칙을 우회하므로, 실제 권한 검사는 pacs/permissions.py·workflow.py에서 합니다.
// 브라우저 등 클라이언트에서의 직접 접근은 모두 차단합니다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
